		biome = "sky",
		rarity = "eternal",
		spawnChance = 0.6,
		hatchSeconds = 1185,
		baseIncome = 537109375000,
		baseWeight = 159.97,
		unlockSpeed = 400000000000,
		modelHeight = 20,
		flavor = "Sings softly at sunrise.",
	},
	heavenly_egg = {
		id = "heavenly_egg",
		name = "Heavenly Egg",
		biome = "sky",
		rarity = "divine",
		spawnChance = 0.3,
		hatchSeconds = 1550,
		baseIncome = 976562500000,
		baseWeight = 246.11,
		unlockSpeed = 400000000000,
		modelHeight = 25,
		flavor = "The rarest egg above the clouds.",
	},
}

EggConfig.RarityById = {}
for _, r in EggConfig.Rarities do
	r.color = Color3.fromHex(r.hex)
	EggConfig.RarityById[r.id] = r
end
EggConfig.BiomeById = {}
for _, b in EggConfig.Biomes do
	b.color = Color3.fromHex(b.hex)
	EggConfig.BiomeById[b.id] = b
end
EggConfig.MutationById = {}
for _, m in EggConfig.Mutations do
	EggConfig.MutationById[m.id] = m
end

local function pick(rng: Random?): number
	return if rng then rng:NextNumber() else math.random()
end

-- Rolls which egg spawns in a biome, using each egg's rarity spawn chance.
function EggConfig.RollEgg(biomeId: string, rng: Random?): string
	local biome = EggConfig.BiomeById[biomeId]
	assert(biome, `unknown biome {biomeId}`)
	local total = 0
	for _, id in biome.eggs do
		total += EggConfig.Eggs[id].spawnChance
	end
	local roll = pick(rng) * total
	for _, id in biome.eggs do
		roll -= EggConfig.Eggs[id].spawnChance
		if roll <= 0 then
			return id
		end
	end
	return biome.eggs[1]
end

-- Weight in kg: around the egg's base weight, sometimes a lot bigger.
function EggConfig.RollWeight(eggId: string, rng: Random?): number
	local egg = EggConfig.Eggs[eggId]
	local u1, u2 = math.max(pick(rng), 1e-6), pick(rng)
	local z = math.sqrt(-2 * math.log(u1)) * math.cos(2 * math.pi * u2)
	local w = egg.baseWeight * math.exp(z * EggConfig.WeightSpread)
	if pick(rng) < EggConfig.HugeChance then
		w *= 3 + pick(rng) * 3
	end
	return math.floor(math.max(w, egg.baseWeight * 0.3) * 10 + 0.5) / 10
end

function EggConfig.RollMutation(rng: Random?): string
	local roll = pick(rng) * 100
	for i = #EggConfig.Mutations, 1, -1 do
		local m = EggConfig.Mutations[i]
		if m.chance > 0 then
			if roll < m.chance then
				return m.id
			end
			roll -= m.chance
		end
	end
	return "normal"
end

-- Money per second once hatched: base income x size bonus x mutation multiplier.
function EggConfig.Income(eggId: string, weightKg: number, mutation: string?): number
	local egg = EggConfig.Eggs[eggId]
	local m = EggConfig.MutationById[mutation or "normal"] or EggConfig.MutationById.normal
	local size = (math.max(weightKg, 0.01) / egg.baseWeight) ^ 0.85
	return egg.baseIncome * size * m.multiplier
end

-- Heavier eggs take a bit longer to hatch.
function EggConfig.HatchSeconds(eggId: string, weightKg: number): number
	local egg = EggConfig.Eggs[eggId]
	local f = 0.75 + 0.25 * math.sqrt(math.max(weightKg, 0.01) / egg.baseWeight)
	return math.floor(egg.hatchSeconds * f + 0.5)
end

-- Model:ScaleTo() factor so an egg of this weight has a sensible in-game size.
function EggConfig.ScaleForWeight(eggId: string, weightKg: number): number
	local egg = EggConfig.Eggs[eggId]
	local rarity = EggConfig.RarityById[egg.rarity]
	local target = EggConfig.BaseEggHeight + EggConfig.HeightPerRarity * (rarity.index - 1)
	local grow = math.clamp((math.max(weightKg, 0.01) / egg.baseWeight) ^ (1 / 3), 0.6, 2.5)
	return target * grow / egg.modelHeight
end

-- WalkSpeed multiplier while carrying an egg of this weight.
function EggConfig.CarrySpeedMultiplier(weightKg: number): number
	return math.clamp(1 - 0.08 * math.log(1 + math.max(weightKg, 0)), 0.4, 1)
end

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx" }
function EggConfig.FormatMoney(n: number): string
	local i = 1
	while math.abs(n) >= 1000 and i < #SUFFIXES do
		n /= 1000
		i += 1
	end
	if i == 1 then
		return string.format("$%d", math.floor(n + 0.5))
	end
	local text = string.format("$%.1f%s", n, SUFFIXES[i])
	return (string.gsub(text, "%.0(%a)", "%1"))
end

return EggConfig
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00008634"><Properties>
<string name="Name">EggMutations</string>
<ProtectedString name="Source"><![CDATA[--!strict
--[[
	EggMutations
	Colour mutations for StudVox eggs. A mutation recolours an egg model at
	runtime (no extra models needed) and multiplies its income (see EggConfig).

	  Silver   metallic silver tint + white sparkles
	  Golden   shiny gold tint + gold sparkles
	  Rainbow  colours cycle through the rainbow (animated on clients)
	  Diamond  see-through ice-blue crystal + sparkles

	Server:  EggMutations.Apply(eggModel, "golden")
	Client:  EggMutations.StartClientEffects()   -- once, animates every Rainbow egg

	The original colours are kept in attributes, so EggMutations.Remove(egg)
	restores the egg exactly.
]]

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local RAINBOW_TAG = "StudVoxRainbowEgg"

local EggMutations = {}

type Look = {
	tint: Color3?,
	amount: number,
	material: Enum.Material?,
	reflectance: number?,
	transparency: number?,
	sparkle: ColorSequence?,
}

local LOOKS: { [string]: Look } = {
	silver = {
		tint = Color3.fromRGB(215, 222, 232),
		amount = 0.6,
		reflectance = 0.25,
		sparkle = ColorSequence.new(Color3.fromRGB(255, 255, 255)),
	},
	golden = {
		tint = Color3.fromRGB(255, 196, 46),
		amount = 0.65,
		reflectance = 0.3,
		sparkle = ColorSequence.new(Color3.fromRGB(255, 220, 90), Color3.fromRGB(255, 170, 30)),
	},
	rainbow = {
		amount = 0,
		sparkle = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
			ColorSequenceKeypoint.new(0.33, Color3.fromRGB(80, 255, 120)),
			ColorSequenceKeypoint.new(0.66, Color3.fromRGB(80, 160, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 80, 255)),
		}),
	},
	diamond = {
		tint = Color3.fromRGB(190, 236, 255),
		amount = 0.7,
		material = Enum.Material.Glass,
		transparency = 0.25,
		reflectance = 0.2,
		sparkle = ColorSequence.new(Color3.fromRGB(200, 245, 255)),
	},
}

local function visibleParts(model: Instance): { BasePart }
	local out = {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Transparency < 1 then
			table.insert(out, d)
		end
	end
	return out
end

local function remember(p: BasePart)
	if p:GetAttribute("SVColor") == nil then
		p:SetAttribute("SVColor", p.Color)
		p:SetAttribute("SVMaterial", p.Material.Name)
		p:SetAttribute("SVReflectance", p.Reflectance)
		p:SetAttribute("SVTransparency", p.Transparency)
	end
end

function EggMutations.Remove(model: Instance)
	CollectionService:RemoveTag(model, RAINBOW_TAG)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d:GetAttribute("SVColor") ~= nil then
			d.Color = d:GetAttribute("SVColor") :: Color3
			d.Material = (Enum.Material :: any)[d:GetAttribute("SVMaterial") :: string]
			d.Reflectance = d:GetAttribute("SVReflectance") :: number
			d.Transparency = d:GetAttribute("SVTransparency") :: number
		elseif d:IsA("ParticleEmitter") and d.Name == "MutationSparkles" then
			d:Destroy()
		end
	end
	model:SetAttribute("Mutation", nil)
end

function EggMutations.Apply(model: Instance, mutation: string)
	EggMutations.Remove(model)
	local look = LOOKS[mutation]
	if look == nil then
		return -- "normal" or unknown: original colours
	end
	model:SetAttribute("Mutation", mutation)
	local parts = visibleParts(model)
	for _, p in parts do
		remember(p)
		local tint = look.tint
		if tint then
			p.Color = p.Color:Lerp(tint, look.amount)
		end
		if look.material and p.Material ~= Enum.Material.Neon then
			p.Material = look.material
		end
		if look.reflectance then
			p.Reflectance = look.reflectance
		end
		if look.transparency and p.Material ~= Enum.Material.Neon then
			p.Transparency = math.max(p.Transparency, look.transparency)
		end
	end
	-- sparkles on the biggest part (uses Roblox's default sparkle texture)
	local biggest: BasePart? = nil
	for _, p in parts do
		if biggest == nil or p.Size.Magnitude > (biggest :: BasePart).Size.Magnitude then
			biggest = p
		end
	end
	if biggest and look.sparkle then
		local e = Instance.new("ParticleEmitter")
		e.Name = "MutationSparkles"
		e.Color = look.sparkle
		e.LightEmission = 1
		e.Rate = 6
		e.Lifetime = NumberRange.new(0.8, 1.4)
		e.Speed = NumberRange.new(0.5, 1.5)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0) })
		e.Parent = biggest
	end
	if mutation == "rainbow" then
		CollectionService:AddTag(model, RAINBOW_TAG)
	end
end

local started = false

-- Clients: animate the rainbow mutation (colour changes stay local, nothing is replicated).
function EggMutations.StartClientEffects()
	if started then
		return
	end
	started = true
	local t = 0
	RunService.RenderStepped:Connect(function(dt: number)
		t += dt
		for _, model in CollectionService:GetTagged(RAINBOW_TAG) do
			if not model:IsDescendantOf(workspace) then
				continue
			end
			for _, d in model:GetDescendants() do
				if d:IsA("BasePart") and d.Transparency < 1 then
					local base = d:GetAttribute("SVColor")
					local h, s, v = 0, 0.75, 1
					if typeof(base) == "Color3" then
						local _, bs, bv = base:ToHSV()
						s, v = math.max(bs, 0.55), math.max(bv, 0.75)
					end
					h = (t * 0.25 + d.Position.Y * 0.04) % 1
					d.Color = Color3.fromHSV(h, s, v)
				end
			end
		end
	end)
end

return EggMutations
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00008635"><Properties>
<string name="Name">EggBillboard</string>
<ProtectedString name="Source"><![CDATA[--!nonstrict
--[[
	EggBillboard
	The floating label over a spawned egg: name, rarity (in its colour),
	weight, income per second and mutation.

	local EggBillboard = require(path.EggBillboard)
	EggBillboard.Attach(eggModel, "sprout_egg", 3.4, "golden")
]]

local EggConfig = require(script.Parent:WaitForChild("EggConfig"))

local EggBillboard = {}

local function label(parent: Instance, name: string, text: string, color: Color3, height: number, order: number)
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.Size = UDim2.new(1, 0, height, 0)
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.Text = text
	l.TextColor3 = color
	l.LayoutOrder = order
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(20, 20, 24)
	stroke.Parent = l
	l.Parent = parent
	return l
end

function EggBillboard.Attach(model: Model, eggId: string, weightKg: number, mutation: string?): BillboardGui
	local egg = EggConfig.Eggs[eggId]
	assert(egg, `unknown egg {eggId}`)
	local rarity = EggConfig.RarityById[egg.rarity]
	local old = model:FindFirstChild("EggBillboard")
	if old then
		old:Destroy()
	end
	local _, size = model:GetBoundingBox()
	local gui = Instance.new("BillboardGui")
	gui.Name = "EggBillboard"
	gui.Size = UDim2.fromScale(7, 3.2)
	gui.StudsOffsetWorldSpace = Vector3.new(0, size.Y / 2 + 2, 0)
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.MaxDistance = 120
	gui.Adornee = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
	local list = Instance.new("UIListLayout")
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.Parent = gui

	local mut = EggConfig.MutationById[mutation or "normal"]
	local title = egg.name
	if mut and mut.id ~= "normal" then
		title = `{mut.title} {egg.name}`
	end
	label(gui, "Name", title, Color3.new(1, 1, 1), 0.32, 1)
	label(gui, "Rarity", rarity.title, rarity.color, 0.24, 2)
	label(gui, "Weight", string.format("%.1f kg", weightKg), Color3.fromRGB(230, 230, 235), 0.2, 3)
	local income = EggConfig.Income(eggId, weightKg, mutation or "normal")
	label(gui, "Income", `{EggConfig.FormatMoney(income)}/s`, Color3.fromRGB(120, 255, 120), 0.22, 4)
	gui.Parent = model
	return gui
end

return EggBillboard
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00008636"><Properties>
<string name="Name">StudVoxelAnimator</string>
<ProtectedString name="Source"><![CDATA[--!strict
--[[
	StudVoxelAnimator
	Plays StudVox clips on a model's Motor6D joints. Nothing to upload:
	clips are plain data (Motor6D.Transform per frame), generated by
	`python -m studvox make`.

	local Animator = require(path.to.StudVoxelAnimator)
	local anim = Animator.new(model, require(model.Clips))
	anim:Start()                   -- step every frame (RunService.PreSimulation)
	anim:Play("walk", 0.2)         -- cross-fade to a looping clip
	anim:Play("attack")            -- one-shot clips return to the previous loop
	anim.Finished.Event:Connect(function(clipName) end)
	anim:Stop(0.3)                 -- fade back to the rest pose
	anim:Destroy()

	Motor6D.Transform does not replicate, so run this on the client (the
	generated "Animate" Script uses RunContext = Client). Drive which clip
	plays from the server by changing the model's "Clip" StringValue.
]]

local RunService = game:GetService("RunService")

export type ClipData = {
	length: number,
	loop: boolean,
	fps: number,
	frames: number,
	tracks: { [string]: { number } },
}

type PlayState = {
	name: string,
	clip: ClipData,
	time: number,
	speed: number,
}

local Animator = {}
Animator.__index = Animator

export type Animator = typeof(setmetatable(
	{} :: {
		model: Instance,
		clips: { [string]: ClipData },
		motors: { [string]: Motor6D },
		current: PlayState?,
		previous: PlayState?,
		fade: number,
		fadeTime: number,
		returnTo: string?,
		connection: RBXScriptConnection?,
		Finished: BindableEvent,
	},
	Animator
))

local IDENTITY = CFrame.identity

local function frameCFrame(track: { number }, i: number): CFrame
	local b = i * 7
	return CFrame.new(track[b + 1], track[b + 2], track[b + 3], track[b + 4], track[b + 5], track[b + 6], track[b + 7])
end

local function sample(state: PlayState, motorName: string): CFrame
	local clip = state.clip
	local track = clip.tracks[motorName]
	if not track then
		return IDENTITY
	end
	local last = clip.frames - 1
	local f = math.clamp(state.time * clip.fps, 0, last)
	local i0 = math.floor(f)
	local a = f - i0
	if i0 >= last then
		return frameCFrame(track, last)
	end
	local c0 = frameCFrame(track, i0)
	if a <= 1e-4 then
		return c0
	end
	return c0:Lerp(frameCFrame(track, i0 + 1), a)
end

function Animator.new(model: Instance, clips: { [string]: ClipData }): Animator
	local motors: { [string]: Motor6D } = {}
	for _, d in model:GetDescendants() do
		if d:IsA("Motor6D") then
			motors[d.Name] = d
		end
	end
	local self = setmetatable({
		model = model,
		clips = clips,
		motors = motors,
		current = nil,
		previous = nil,
		fade = 0,
		fadeTime = 0,
		returnTo = nil,
		connection = nil,
		Finished = Instance.new("BindableEvent"),
	}, Animator)
	return self
end

function Animator.GetClipNames(self: Animator): { string }
	local names = {}
	for name in self.clips do
		table.insert(names, name)
	end
	table.sort(names)
	return names
end

function Animator.IsPlaying(self: Animator, name: string?): boolean
	local cur = self.current
	if cur == nil then
		return false
	end
	return name == nil or cur.name == name
end

function Animator.Play(self: Animator, name: string, fadeTime: number?, speed: number?)
	local clip = self.clips[name]
	if clip == nil then
		warn(`StudVoxelAnimator: no clip named "{name}"`)
		return
	end
	local cur = self.current
	if cur and cur.name == name and clip.loop then
		cur.speed = speed or cur.speed
		return
	end
	if not clip.loop then
		-- one-shot: remember the loop we came from so we can go back to it
		if cur and cur.clip.loop then
			self.returnTo = cur.name
		end
	else
		self.returnTo = nil
	end
	self.previous = cur
	self.current = { name = name, clip = clip, time = 0, speed = speed or 1 }
	self.fade = 0
	self.fadeTime = fadeTime or 0.15
end

function Animator.Stop(self: Animator, fadeTime: number?)
	self.previous = self.current
	self.current = nil
	self.returnTo = nil
	self.fade = 0
	self.fadeTime = fadeTime or 0.15
end

local function advance(state: PlayState, dt: number): boolean
	-- returns true when a one-shot clip just finished
	state.time += dt * state.speed
	local len = state.clip.length
	if state.clip.loop then
		if len > 0 then
			state.time %= len
		end
		return false
	end
	if state.time >= len then
		state.time = len
		return true
	end
	return false
end

function Animator.Step(self: Animator, dt: number)
	local cur = self.current
	local prev = self.previous
	if cur then
		local finished = advance(cur, dt)
		if finished then
			self.Finished:Fire(cur.name)
			local back = self.returnTo
			if back then
				self.returnTo = nil
				self:Play(back, 0.2)
				cur = self.current
				prev = self.previous
			end
		end
	end
	if prev then
		advance(prev, dt)
	end
	self.fade += dt
	local alpha = if self.fadeTime > 0 then math.clamp(self.fade / self.fadeTime, 0, 1) else 1
	if alpha >= 1 then
		self.previous = nil
		prev = nil
	end
	for name, motor in self.motors do
		local target = if cur then sample(cur, name) else IDENTITY
		if prev then
			target = sample(prev, name):Lerp(target, alpha)
		elseif cur == nil and alpha < 1 then
			target = motor.Transform:Lerp(IDENTITY, alpha)
		end
		motor.Transform = target
	end
end

function Animator.Start(self: Animator)
	if self.connection then
		return
	end
	self.connection = RunService.PreSimulation:Connect(function(dt: number)
		self:Step(dt)
	end)
end

function Animator.Destroy(self: Animator)
	if self.connection then
		self.connection:Disconnect()
		self.connection = nil
	end
	for _, motor in self.motors do
		motor.Transform = IDENTITY
	end
	self.Finished:Destroy()
end

return Animator
]]></ProtectedString>
</Properties>
</Item>
<Item class="Folder" referent="RBX00008637"><Properties>
<string name="Name">Examples</string>
</Properties>
<Item class="Script" referent="RBX00008638"><Properties>
<string name="Name">EggSpawner</string>
<ProtectedString name="Source"><![CDATA[--[[
	EggSpawner (example server Script, move it to ServerScriptService)

	Spawns StudVox eggs on spawn pads, the way egg-stealing games do:
	  * every Part tagged "EggSpawn" (CollectionService) is a pad; give it a
	    string attribute "Biome" = a biome id from EggConfig (e.g. "meadow")
	  * when a pad is empty it waits SPAWN_DELAY seconds, rolls an egg of that
	    biome by rarity chance, rolls its weight (kg) and a mutation, scales the
	    model to its weight and puts a billboard above it
	  * the egg carries its data as attributes: EggId, WeightKg, Mutation, Income

	Expected setup:
	  ReplicatedStorage.StudVoxEggs (the EggPack.rbxmx folder) with
	    Eggs/<biome>/<egg model>, EggConfig, EggMutations, EggBillboard
	  Clients call EggMutations.StartClientEffects() once (for rainbow eggs).

	Picking up, carrying (see EggConfig.CarrySpeedMultiplier), stealing and
	hatching (EggConfig.HatchSeconds / Income) belong to your game logic.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local pack = ReplicatedStorage:WaitForChild("StudVoxEggs")
local EggConfig = require(pack:WaitForChild("EggConfig"))
local EggMutations = require(pack:WaitForChild("EggMutations"))
local EggBillboard = require(pack:WaitForChild("EggBillboard"))

local SPAWN_DELAY = 20
local rng = Random.new()
local busy: { [BasePart]: Model } = {}

local function spawnOn(pad: BasePart)
	local biome = pad:GetAttribute("Biome")
	if typeof(biome) ~= "string" or EggConfig.BiomeById[biome] == nil then
		warn(`EggSpawner: {pad:GetFullName()} needs a valid "Biome" attribute`)
		return
	end
	local eggId = EggConfig.RollEgg(biome, rng)
	local template = pack.Eggs:FindFirstChild(biome) and pack.Eggs[biome]:FindFirstChild(eggId)
	if template == nil then
		warn(`EggSpawner: no model for {eggId}`)
		return
	end
	local weight = EggConfig.RollWeight(eggId, rng)
	local mutation = EggConfig.RollMutation(rng)
	local egg = template:Clone() :: Model
	egg:ScaleTo(EggConfig.ScaleForWeight(eggId, weight))
	egg:PivotTo(pad.CFrame * CFrame.new(0, pad.Size.Y / 2, 0))
	egg:SetAttribute("EggId", eggId)
	egg:SetAttribute("WeightKg", weight)
	egg:SetAttribute("Mutation", mutation)
	egg:SetAttribute("Income", EggConfig.Income(eggId, weight, mutation))
	EggMutations.Apply(egg, mutation)
	EggBillboard.Attach(egg, eggId, weight, mutation)
	egg.Parent = workspace
	busy[pad] = egg
	egg.AncestryChanged:Connect(function()
		if not egg:IsDescendantOf(workspace) and busy[pad] == egg then
			busy[pad] = nil -- picked up or removed: the pad can spawn again
		end
	end)
end

local function watch(pad: Instance)
	if not pad:IsA("BasePart") then
		return
	end
	task.spawn(function()
		while pad.Parent do
			if busy[pad] == nil then
				task.wait(SPAWN_DELAY)
				if pad.Parent and busy[pad] == nil then
					spawnOn(pad)
				end
			end
			task.wait(1)
		end
		busy[pad] = nil
	end)
end

for _, pad in CollectionService:GetTagged("EggSpawn") do
	watch(pad)
end
CollectionService:GetInstanceAddedSignal("EggSpawn"):Connect(watch)
]]></ProtectedString>
</Properties>
</Item>
