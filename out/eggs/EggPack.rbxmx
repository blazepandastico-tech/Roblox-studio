				0, 0, 0, -0.0129, 0.0003, -0.0215, 0.9997, 0, 0, 0, -0.0126, 0.0003, -0.0209, 0.9997, 0, 0, 0, -0.0121, 0.0002, -0.0202, 0.9997, 0, 0, 0, -0.0115, 0.0002, -0.0191, 0.9998,
				0, 0, 0, -0.0107, 0.0002, -0.0179, 0.9998, 0, 0, 0, -0.0098, 0.0002, -0.0164, 0.9998, 0, 0, 0, -0.0088, 0.0001, -0.0147, 0.9999, 0, 0, 0, -0.0077, 0.0001, -0.0129, 0.9999,
				0, 0, 0, -0.0065, 0.0001, -0.0109, 0.9999, 0, 0, 0, -0.0053, 0, -0.0088, 0.9999, 0, 0, 0, -0.0039, 0, -0.0066, 1, 0, 0, 0, -0.0026, 0, -0.0043, 1,
				0, 0, 0, -0.0011, 0, -0.0019, 1, 0, 0, 0, 0.0003, 0, 0.0005, 1, 0, 0, 0, 0.0017, 0, 0.0028, 1, 0, 0, 0, 0.0031, 0, 0.0052, 1,
				0, 0, 0, 0.0045, 0, 0.0075, 1, 0, 0, 0, 0.0058, 0.0001, 0.0096, 0.9999, 0, 0, 0, 0.007, 0.0001, 0.0117, 0.9999, 0, 0, 0, 0.0082, 0.0001, 0.0137, 0.9999,
