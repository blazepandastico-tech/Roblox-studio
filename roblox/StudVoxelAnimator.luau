--!strict
--[[
	StudVoxelAnimator
	Plays StudVox clips on a model's Motor6D joints. Nothing to upload:
	clips are plain data (Motor6D.Transform per frame), generated by
	`python -m studvox make`.

	local Animator = require(path.to.StudVoxelAnimator)
	local anim = Animator.new(model, require(model.Clips))
	anim:Start()                   -- step every frame (RunService.PreSimulation)
	anim:Play("walk", 0.2)         -- cross-fade to a looping clip
	anim:Play("attack")            -- one-shot clips return to the previous loop
	anim.Finished.Event:Connect(function(clipName) end)
	anim:Stop(0.3)                 -- fade back to the rest pose
	anim:Destroy()

	Motor6D.Transform does not replicate, so run this on the client (the
	generated "Animate" Script uses RunContext = Client). Drive which clip
	plays from the server by changing the model's "Clip" StringValue.
]]

local RunService = game:GetService("RunService")

export type ClipData = {
	length: number,
	loop: boolean,
	fps: number,
	frames: number,
	tracks: { [string]: { number } },
}

type PlayState = {
	name: string,
	clip: ClipData,
	time: number,
	speed: number,
}

local Animator = {}
Animator.__index = Animator

export type Animator = typeof(setmetatable(
	{} :: {
		model: Instance,
		clips: { [string]: ClipData },
		motors: { [string]: Motor6D },
		current: PlayState?,
		previous: PlayState?,
		fade: number,
		fadeTime: number,
		returnTo: string?,
		connection: RBXScriptConnection?,
		Finished: BindableEvent,
	},
	Animator
))

local IDENTITY = CFrame.identity

local function frameCFrame(track: { number }, i: number): CFrame
	local b = i * 7
	return CFrame.new(track[b + 1], track[b + 2], track[b + 3], track[b + 4], track[b + 5], track[b + 6], track[b + 7])
end

local function sample(state: PlayState, motorName: string): CFrame
	local clip = state.clip
	local track = clip.tracks[motorName]
	if not track then
		return IDENTITY
	end
	local last = clip.frames - 1
	local f = math.clamp(state.time * clip.fps, 0, last)
	local i0 = math.floor(f)
	local a = f - i0
	if i0 >= last then
		return frameCFrame(track, last)
	end
	local c0 = frameCFrame(track, i0)
	if a <= 1e-4 then
		return c0
	end
	return c0:Lerp(frameCFrame(track, i0 + 1), a)
end

function Animator.new(model: Instance, clips: { [string]: ClipData }): Animator
	local motors: { [string]: Motor6D } = {}
	for _, d in model:GetDescendants() do
		if d:IsA("Motor6D") then
			motors[d.Name] = d
		end
	end
	local self = setmetatable({
		model = model,
		clips = clips,
		motors = motors,
		current = nil,
		previous = nil,
		fade = 0,
		fadeTime = 0,
		returnTo = nil,
		connection = nil,
		Finished = Instance.new("BindableEvent"),
	}, Animator)
	return self
end

function Animator.GetClipNames(self: Animator): { string }
	local names = {}
	for name in self.clips do
		table.insert(names, name)
	end
	table.sort(names)
	return names
end

function Animator.IsPlaying(self: Animator, name: string?): boolean
	local cur = self.current
	if cur == nil then
		return false
	end
	return name == nil or cur.name == name
end

function Animator.Play(self: Animator, name: string, fadeTime: number?, speed: number?)
	local clip = self.clips[name]
	if clip == nil then
		warn(`StudVoxelAnimator: no clip named "{name}"`)
		return
	end
	local cur = self.current
	if cur and cur.name == name and clip.loop then
		cur.speed = speed or cur.speed
		return
	end
	if not clip.loop then
		-- one-shot: remember the loop we came from so we can go back to it
		if cur and cur.clip.loop then
			self.returnTo = cur.name
		end
	else
		self.returnTo = nil
	end
	self.previous = cur
	self.current = { name = name, clip = clip, time = 0, speed = speed or 1 }
	self.fade = 0
	self.fadeTime = fadeTime or 0.15
end

function Animator.Stop(self: Animator, fadeTime: number?)
	self.previous = self.current
	self.current = nil
	self.returnTo = nil
	self.fade = 0
	self.fadeTime = fadeTime or 0.15
end

local function advance(state: PlayState, dt: number): boolean
	-- returns true when a one-shot clip just finished
	state.time += dt * state.speed
	local len = state.clip.length
	if state.clip.loop then
		if len > 0 then
			state.time %= len
		end
		return false
	end
	if state.time >= len then
		state.time = len
		return true
	end
	return false
end

function Animator.Step(self: Animator, dt: number)
	local cur = self.current
	local prev = self.previous
	if cur then
		local finished = advance(cur, dt)
		if finished then
			self.Finished:Fire(cur.name)
			local back = self.returnTo
			if back then
				self.returnTo = nil
				self:Play(back, 0.2)
				cur = self.current
				prev = self.previous
			end
		end
	end
	if prev then
		advance(prev, dt)
	end
	self.fade += dt
	local alpha = if self.fadeTime > 0 then math.clamp(self.fade / self.fadeTime, 0, 1) else 1
	if alpha >= 1 then
		self.previous = nil
		prev = nil
	end
	for name, motor in self.motors do
		local target = if cur then sample(cur, name) else IDENTITY
		if prev then
			target = sample(prev, name):Lerp(target, alpha)
		elseif cur == nil and alpha < 1 then
			target = motor.Transform:Lerp(IDENTITY, alpha)
		end
		motor.Transform = target
	end
end

function Animator.Start(self: Animator)
	if self.connection then
		return
	end
	self.connection = RunService.PreSimulation:Connect(function(dt: number)
		self:Step(dt)
	end)
end

function Animator.Destroy(self: Animator)
	if self.connection then
		self.connection:Disconnect()
		self.connection = nil
	end
	for _, motor in self.motors do
		motor.Transform = IDENTITY
	end
	self.Finished:Destroy()
end

return Animator
