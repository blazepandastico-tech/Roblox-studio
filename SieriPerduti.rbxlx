		ComboResetTime = 0.9,
		BladeReach = 13,
		MinAttackInterval = 0.2,
		HitValidationSlack = 14,
		MaxHitsPerSwing = 4,
		SpeedBonusStart = 40, -- velocità oltre cui il danno aumenta
