	-- ISOLA DEI RAID --------------------------------------------------------------------
	{
		Id = "ArenaRaid",
		Name = "Arena dei Raid",
		Season = 1,
		Raid = true,
		Spawn = true,
		Center = W.At("Arena", 0, 0, G),
