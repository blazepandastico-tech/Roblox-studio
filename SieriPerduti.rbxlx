	local skills = New("Frame", { Name = "TouchAbilita", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -110), Size = UDim2.fromOffset(4 * 64, 64), BackgroundTransparency = 1, Parent = root })
