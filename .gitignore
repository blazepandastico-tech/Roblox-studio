# Python
__pycache__/
*.pyc
.venv*/

# Build outputs: keep Studio files (.rbxmx/.luau), sheets and previews; everything else is regenerated by
# `python -m studvox make ...` (renders, FBX/GLB/OBJ exports, .blend files, logs)
/out/**/renders/
/out/**/*.png
/out/**/*.blend
/out/**/*.blend1
/out/**/blender.log
/out/**/roblox.txt
/out/**/*.svox.json
/out/**/*.fbx
/out/**/*.glb
/out/**/*.obj
/out/**/*.mtl
/out/**/anims/
/out/eggs_mutations/
# the 140 eggs ship together in out/eggs/EggPack.rbxmx
/out/eggs/*/*.rbxmx
/out/eggs/*/*.luau
/out/eggs/*/stats.json
